generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model ciudad {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar
  latitud   Float
  longitud  Float
  prevision prevision[]
}

model condicion_meteorologica {
  id        Int         @id @default(autoincrement())
  tipo      String      @db.VarChar
  detalle   String      @db.VarChar
  prevision prevision[]
}

model prevision {
  id                      Int                     @id @default(autoincrement())
  fecha                   DateTime                @db.Timestamp(6)
  temperaturaMinima       Float
  temperaturaMaxima       Float
  ciudadId                Int
  condicionId             Int
  ciudad                  ciudad                  @relation(fields: [ciudadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  condicion_meteorologica condicion_meteorologica @relation(fields: [condicionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ciudadId, fecha], map: "uix_ciudad_fecha")
}
